;; swh-framework/lbrain/deps.edn
{:paths ["src" "classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        org.clojure/core.logic {:mvn/version "1.1.1"}
        org.babashka/sci {:mvn/version "0.8.41"}
        tools.aqua/z3-turnkey {:mvn/version "4.12.4"}
        net.java.dev.jna/jna {:mvn/version "5.19.1"}
        org.graalvm.sdk/graal-sdk {:mvn/version "24.1.0"}}

 :aliases
 {:build
  {:extra-paths ["classes"]
   :jvm-opts ["-Dclojure.compiler.direct-linking=true"]}

  ;; GraalVM Native AOT C 동적 라이브러리(libyahweh.so) 빌드 알리아스
  :native-image
  {:extra-paths ["classes"]
   :extra-deps {org.graalvm.buildtools/native-maven-plugin {:mvn/version "0.10.3"}}
   :main-opts ["-m" "lbrain.native"]
   :jvm-opts ["-Dclojure.compiler.direct-linking=true"
              "-Dclojure.spec.skip-macros=true"]}}}